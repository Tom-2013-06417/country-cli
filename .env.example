# Copy to .env and fill in values:
#   cp .env.example .env
#
# Never commit .env — it may contain your real API key.

# Where countries.html and countries.csv are written
OUTPUT_DIR=./output

# Countries API v5 base URL (do not use legacy restcountries.com/v3.1)
COUNTRIES_API_BASE_URL=https://api.restcountries.com/countries/v5

# Required. Get a key at https://restcountries.com/sign-up
# Demo key rc_live_demo only returns sample-shaped data — use your own key for a full run.
COUNTRIES_API_KEY=YOUR_API_KEY

# Page size (limit) sent to the API. Free plan max is typically 100.
DEFAULT_MAX_PAGINATION_SIZE=100
